rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApproved() {
      let d = get(/databases/$(database)/documents/umpires/$(request.auth.uid)).data;
      return isSignedIn() && d.approved == true && d.get('active', true) != false;
    }

    function isApprovedCoach() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/coaches/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data.approved == true;
    }

    function isSuperAdmin() {
      let d = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      // Accept superAdmin:true OR roles:[] — the latter covers accounts created before the
      // explicit superAdmin flag was introduced.
      return isAdmin() && (d.superAdmin == true || !('roles' in d) || d.roles.size() == 0);
    }

    // Games: anyone can read; only admins can create/delete;
    // approved umpires may update ONLY the umpireSlots field on non-cancelled games
    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isApproved() &&
         resource.data.get('cancelled', false) != true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['umpireSlots', 'needsUmpires']));
    }

    // Umpires: own profile read/create; admin can read/update all;
    // approved umpires can read any umpire profile (co-umpire contact info for game coordination);
    // approved umpires may update their own non-sensitive fields
    match /umpires/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin() || isApproved();
      allow create: if request.auth.uid == uid;
      allow update: if isAdmin()
                 || (isSignedIn() && request.auth.uid == uid
                     && request.resource.data.approved  == resource.data.approved
                     && request.resource.data.get('active', true) == resource.data.get('active', true));
      allow delete: if isAdmin();
    }

    // Config: approved umpires can read general config; slackWebhooks requires superAdmin
    match /config/{docId} {
      allow read:  if docId == "slackWebhooks" ? isSuperAdmin() : isSignedIn();
      allow write: if docId == "slackWebhooks" ? isSuperAdmin() : isAdmin();
    }

    // Admins collection: own doc self-read (breaks circular dependency)
    // write requires super-admin for creating/deleting admins; regular admins can update their own doc
    match /admins/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAdmin() && request.auth.uid == uid);
    }

    // FCM notification tokens: own doc only
    match /notifications/{uid} {
      allow read, write: if request.auth.uid == uid;
      allow read:        if isAdmin();
    }

    // Umpire availability: own doc read/write; admins can read for assignment planning
    match /availability/{uid} {
      allow read, write: if request.auth.uid == uid;
      allow read:        if isAdmin();
    }

    // Incident reports: approved umpires, admins, or any signed-in user (coaches) can create;
    // admins have full access; reporters can read their own.
    match /incidentReports/{reportId} {
      allow create: if isApproved() || isAdmin() || isApprovedCoach();
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Umpire requests from coaches: anyone can create; only admins can read/update;
    // submitting coach can read their own requests
    match /umpireRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
      allow read: if isApprovedCoach() && resource.data.submittedBy == request.auth.uid;
    }

    // Coaches: own profile read/create; admin can read/update/delete all
    match /coaches/{uid} {
      allow read:   if request.auth.uid == uid || isAdmin();
      allow create: if request.auth.uid == uid || isAdmin();
      allow update: if isAdmin()
                 || (isSignedIn() && request.auth.uid == uid
                     && request.resource.data.approved  == resource.data.approved
                     && request.resource.data.get('active', true) == resource.data.get('active', true));
      allow delete: if isAdmin();
    }

    // Tournaments: public read; admins can write
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Facilities: public read; admins can write
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leagues: public read; admins can write
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Facility shed codes: signed-in approved umpires and admins can read; only admins can write
    match /facilityCodes/{facilityId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // Field issue reports: anyone can submit; logged-in users can read their own; admins can read all
    match /fieldIssues/{issueId} {
      allow read:   if isAdmin() || isApproved() ||
                       (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Announcements: approved umpires can read; only admins can write
    match /announcements/{announcementId} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // Login history: any signed-in user can create their own record; only admins can read
    match /loginHistory/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // Cancellation requests: umpires create/read/withdraw their own; admins can read all and approve/deny
    match /cancellationRequests/{requestId} {
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid &&
         resource.data.status == "pending" &&
         request.resource.data.status == "withdrawn");
      allow delete: if isAdmin();
    }

    // Practice requests: anyone can submit (coaches, no account required); admins can read/update/delete;
    // submitting coach can read their own requests
    match /practiceRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
      allow read: if isApprovedCoach() && resource.data.submittedBy == request.auth.uid;
    }

    // Approved practices: public read; admins can write
    match /practices/{practiceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Player rosters: keyed by team stable ID; admins and approved coaches can read;
    // approved coaches can write (needed for roster management tab)
    match /rosters/{teamId} {
      allow read:  if isAdmin() || isApprovedCoach();
      allow write: if isAdmin() || isApprovedCoach();
    }

    // Player call-up requests: coach-to-coach workflow
    match /callupRequests/{requestId} {
      // Any approved coach or admin can create a request
      allow create: if isApprovedCoach() || isAdmin();
      // Requesting coach, home coach, or admin can read
      allow read: if isAdmin() ||
        (isSignedIn() && (
          resource.data.requestingCoachId == request.auth.uid ||
          resource.data.homeCoachId == request.auth.uid
        ));
      // Home coach can approve/decline; requesting coach can withdraw (pending only)
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.homeCoachId == request.auth.uid) ||
        (isSignedIn() && resource.data.requestingCoachId == request.auth.uid &&
         resource.data.status == "pending" && request.resource.data.status == "withdrawn");
      allow delete: if isAdmin();
    }

    // Sponsors: admin-only (amounts and contact info are internal)
    match /sponsors/{sponsorId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Manual (unscheduled) umpire pay entries: admin only
    match /manualPay/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
